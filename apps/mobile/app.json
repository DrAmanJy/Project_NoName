{
  "expo": {
    "name": "Synex",
    "slug": "synex",
    "icon": "./assets/icon.png",
    "version": "1.0.0",
    "scheme": "noname",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.trueservices.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.trueservices.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d71d9eef-286e-49ee-b5b2-78bfb8aa651a"
      }
    }
  }
}
