{
  "expo": {
    "name": "noname",
    "slug": "noname-mobile",
    "version": "1.0.0",
    "scheme": "noname",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.noname.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.noname.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
