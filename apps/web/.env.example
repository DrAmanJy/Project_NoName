# ─── Web App Environment Variables ────────────────────────────────────────────
#
# Copy this file to .env.local for local development.
#
# HOW THE API PROXY WORKS
# ────────────────────────
# The web app proxies all /api/v1/* requests through Next.js to the real API.
# This means the browser NEVER makes a cross-site request to the API domain.
# Session cookies are set and read on the same origin (the web domain), which
# avoids Chrome's third-party cookie partitioning (CHIPS) that was causing
# login failures for some users.
#
# PRODUCTION SETUP (Vercel)
# ──────────────────────────
# Set in the Vercel dashboard for the web project:
#
#   NEXT_PUBLIC_API_URL   →  (leave empty or remove the variable entirely)
#   API_UPSTREAM_URL      →  https://project-no-name-api-rosy.vercel.app
#
# LOCAL DEV SETUP
# ────────────────
# Run the API on localhost:3001 and the web on localhost:3000.
# The proxy will forward /api/v1/* to http://localhost:3001.

# Browser-side API base URL.
# Empty = use same-origin path /api/v1 (recommended — works with proxy).
# Only set this to an absolute URL if you want to bypass the proxy entirely.
NEXT_PUBLIC_API_URL=""

# Server-side only — the real API host Next.js proxies requests to.
# NEVER add a NEXT_PUBLIC_ prefix to this variable.
API_UPSTREAM_URL="http://localhost:3001"

# Gmail Nodemailer Configuration for lead submissions
# The Gmail account address to send emails from
GMAIL_USER=""
# Gmail App Password (generate via Google Account Security page)
GMAIL_APP_PASSWORD=""
# Destination email address (falls back to GMAIL_USER if left empty)
ADMIN_EMAIL=""

